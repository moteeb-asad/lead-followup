{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "node"],
  "env": { "node": true },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    // Use console.info for status messages and console.warn or console.error
    // for problems. console.log and console.debug are easy to leave behind
    // with a password or token in them.
    "no-console": ["error", { "allow": ["info", "warn", "error"] }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "child_process",
            "message": "The API doesn't run shell commands. Ask the maintainer first."
          },
          {
            "name": "node:child_process",
            "message": "The API doesn't run shell commands. Ask the maintainer first."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // Command-line scripts print their results to the terminal. That is
      // their output, not logging.
      "files": ["scripts/**"],
      "rules": { "no-console": "off" }
    }
  ]
}
